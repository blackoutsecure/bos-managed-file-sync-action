{
  "security": {
    "enable_python_lint": true,
    "python_version": "3.12",
    "readme_header_profile": "marketplace"
  },
  "managed_file_sync": {
    "direction": "source-to-destination",
    "use_marketplace_config": false
  },
  "marketplace": {
    "enabled": true,
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      "README.md",
      "LICENSE",
      "NOTICE",
      "src"
    ],
    "blocked_paths": [
      ".github/workflows/",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".markdownlint.yaml",
      ".shellcheckrc",
      "pyproject.toml",
      "scripts/",
      "test/"
    ],
    "required_paths": [
      ".github/dependabot.yml",
      "action.yml",
      "src",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "include_dependabot_config": true,
    "repo_metadata": {
      "enable": true,
      "homepage": "https://github.com/marketplace/actions/blackout-secure-managed-file-sync",
      "generate_topics": true,
      "topics_fallback": "github-actions managed-files repo-standardization drift-detection dotfiles codeowners dependabot editorconfig composite-action devops"
    }
  },
  "general": {
    "action_test": {
      "python_versions": ["3.10", "3.11", "3.12"]
    }
  }
}
