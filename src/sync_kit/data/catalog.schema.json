{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/blackoutsecure/bos-managed-file-sync-action/main/src/sync_kit/data/catalog.schema.json",
  "title": "Managed File Sync catalog",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "services": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/service" }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "oneOf": [{ "required": ["files"] }, { "required": ["includes"] }],
      "properties": {
        "description": { "type": "string" },
        "mode": { "enum": ["block", "file", "init", "absent"], "default": "block" },
        "includes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Bundle: expands to the listed services instead of managing files directly."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/managedFile" }
        }
      },
      "additionalProperties": false
    },
    "managedFile": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Repo-relative path. Absolute paths and '..' segments are rejected."
        },
        "mode": { "enum": ["block", "file", "init", "absent"] },
        "comment_prefix": {
          "type": "string",
          "description": "Comment syntax for markers. Use 'open|close' for wrapping styles, e.g. '<!--|-->'."
        },
        "scaffold": {
          "type": ["string", "array"],
          "items": { "type": "string" },
          "description": "Block mode only: root structure written once when the file is created."
        },
        "content": { "type": ["string", "array"] },
        "content_lines": { "type": "array", "items": { "type": "string" } },
        "content_file": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
